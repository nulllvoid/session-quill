{
  "name": "session-quill",
  "version": "2.3.0",
  "description": "Ticket-bound Claude Code sessions with recoverable local notes and a personal dashboard",
  "type": "module",
  "private": true,
  "bin": { "quill": "bin/quill.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node scripts/test-run.mjs \"tests/**/*.test.js\"",
    "bench:hooks": "node scripts/bench-hooks.mjs",
    "test:acceptance":"node scripts/test-run.mjs \"tests/acceptance/*.test.js\"",
    "test:ci": "node scripts/test-run.mjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=test-results.tap \"tests/**/*.test.js\""
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/nulllvoid/session-quill.git" }
}
