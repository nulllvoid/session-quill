{
  "name": "session-quill",
  "version": "1.0.0",
  "description": "Connect Claude Code sessions to tickets, preserve local work history, and run agents in isolated worktrees with worker-run test checks.",
  "type": "module",
  "private": true,
  "bin": {
    "quill": "bin/quill.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "bench:hooks": "node scripts/bench-hooks.mjs",
    "test:acceptance": "node --test \"tests/acceptance/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=test-results.tap \"tests/**/*.test.js\"",
    "check:submission": "node scripts/check-submission.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nulllvoid/session-quill.git"
  }
}
